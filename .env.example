POSTGRES_USER=commerceops
POSTGRES_PASSWORD=commerceops
POSTGRES_DB=copilot
# Host-side tools (make seed, tests) connect here; compose publishes POSTGRES_PORT.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Mock order system seed. AS_OF is fixed so IDs, return windows and eval answers stay
# stable; set it only to re-anchor the data on purpose.
# SEED_AS_OF=2026-10-05

# Mock order API (http://localhost:8001). Dev-only keys: name:key:scopes, comma-separated.
MOCK_API_PORT=8001
MOCK_API_KEYS=copilot:dev-copilot-key:read,admin:dev-admin-key:read+write
# Realism flags, off by default: latency in ms ("250" or "50-400") and a random 5xx share.
MOCK_API_LATENCY_MS=0
MOCK_API_ERROR_RATE=0
